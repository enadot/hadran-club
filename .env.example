# Base URL of the Kehilot Card public API.
# Only the public endpoints (/public/balance, /public/activate, /public/topup) are
# used, so no API key belongs here. Override to point at a staging host.
KEHILOT_API_BASE=https://kehilotcard.co.il/api/v1

# Destination of every "אזור אישי" link. The member area is operated by Kehilot Card
# on their own platform; this site only links out to it.
NEXT_PUBLIC_MEMBER_AREA_URL=https://kehilotcard.co.il/login

# The card-activation screen embedded at /activate. It is operated by Kehilot Card
# on their own platform; this site frames it until the public card-activate endpoint
# accepts activations for the club, at which point /activate goes back to the club's
# own form (parked at /archive/activate).
NEXT_PUBLIC_CARD_ACTIVATION_URL=https://kehilotcard.co.il/activate

# Cropping the operator's own chrome out of that frame. Off by default.
#
# Their screen carries a badge, a title and a step indicator above the form, and
# /activate already says all three in its own header. A cross-origin document cannot
# be edited or partly selected, so the only technique available is to render the
# frame taller than the visible window and slide it up behind a clip.
#
# That is a measurement against someone else's layout and it will drift the first
# time they reflow their header — which is why it lives here rather than in the code.
# Dial it in against the live page, checking a phone width as well as a desktop one;
# the two often need different numbers, and only one value can be set.
#
# FRAME_HEIGHT is how tall the <iframe> element renders. Once anything is cropped it
# has to be tall enough for their whole form, because a tall frame is what removes
# their internal scrollbar — set it short and the end of the form is unreachable.
# Leave it empty for the default 1600px. With no crop set at all the frame ignores it
# and fits the viewport instead.
#
# The durable fix is the operator serving an embeddable variant of the screen with
# their chrome omitted. Worth asking them for.
NEXT_PUBLIC_CARD_ACTIVATION_CROP_TOP=
NEXT_PUBLIC_CARD_ACTIVATION_CROP_BOTTOM=
NEXT_PUBLIC_CARD_ACTIVATION_FRAME_HEIGHT=
