# Base URL of the Kehilot Card public API.
# Only the public endpoints (/public/balance, /public/activate, /public/topup) are
# used, so no API key belongs here. Override to point at a staging host.
KEHILOT_API_BASE=https://kehilotcard.co.il/api/v1

# Destination of every "אזור אישי" link. The member area is operated by Kehilot Card
# on their own platform; this site only links out to it.
NEXT_PUBLIC_MEMBER_AREA_URL=https://kehilotcard.co.il
